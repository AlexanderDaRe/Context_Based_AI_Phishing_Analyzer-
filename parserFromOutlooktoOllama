import os
import json
import re
import logging
import requests
import msal
from dotenv import load_dotenv

#put environment variables in azure 

load_dotenv()
logging.basicConfig(level=logging.INFO, format="%(asctime)s [%(levelname)s] %(message)s")
log = logging.getLogger(__name__)


TENANT_ID     = os.getenv("GRAPH_TENANT_ID")
CLIENT_ID     = os.getenv("GRAPH_CLIENT_ID")
CLIENT_SECRET = os.getenv("GRAPH_CLIENT_SECRET")
USER_EMAIL    = os.getenv("GRAPH_USER_EMAIL")
OLLAMA_URL    = os.getenv("OLLAMA_BASE_URL", "http://localhost:11434")
OLLAMA_MODEL  = os.getenv("OLLAMA_MODEL", "llama3")

GRAPH_BASE = "https://graph.microsoft.com/v1.0"


# Might have to ask jamie about if he is going to use a base prompt this is just for testing
SYSTEM_PROMPT = """You are a cybersecurity expert specialising in email phishing detection.
Analyse the supplied email metadata and body, then respond with a JSON object:
IMPORTANT ONLY RESPOND IN THE EXPEDCTED FORMAT:

{
  "verdict": "phishing" | "suspicious" | "legitimate",
  "confidence": 0-100,
  "risk_factors": ["..."],
  "recommendations": ["..."],
  "summary": "one-sentence plain-language summary"
}

"""


def get_token():
    app = msal.ConfidentialClientApplication(
        CLIENT_ID, CLIENT_SECRET,
        authority=f"https://login.microsoftonline.com/{TENANT_ID}",
    )
    result = app.acquire_token_for_client(scopes=["https://graph.microsoft.com/.default"])
    if "access_token" not in result:
        raise RuntimeError(f"Auth failed: {result.get('error_description')}")
    return result["access_token"]


def graph_get(token, path, params=None):
    resp = requests.get(
        f"{GRAPH_BASE}{path}",
        headers={"Authorization": f"Bearer {token}"},
        params=params or {},
        timeout=30,
    )
    resp.raise_for_status()
    return resp.json()


def fetch_messages(token, top=10):
    return graph_get(token, f"/users/{USER_EMAIL}/mailFolders/inbox/messages", {
        "$top": top,
        "$select": "id,subject,from,receivedDateTime,internetMessageId",
        "$orderby": "receivedDateTime desc",
    }).get("value", [])


def fetch_message_detail(token, message_id):
    return graph_get(token, f"/users/{USER_EMAIL}/messages/{message_id}", {
        "$select": "subject,from,internetMessageId,internetMessageHeaders,body"
    })


def parse_headers(raw_headers):
    """Turn Graph's [{name, value}] list into a flat lowercase dict."""
    return {h["name"].lower(): h["value"] for h in raw_headers}


def extract_email_data(detail):
    headers  = parse_headers(detail.get("internetMessageHeaders", []))
    body_obj = detail.get("body", {})
    body     = body_obj.get("content", "")

    if body_obj.get("contentType") == "html":
        body = re.sub(r"<[^>]+>", " ", body).strip()

    return {
        "subject":                detail.get("subject", ""),
        "from":                   detail.get("from", {}).get("emailAddress", {}).get("address", ""),
        "message_id":             detail.get("internetMessageId", ""),
        "reply_to":               headers.get("reply-to"),
        "return_path":            headers.get("return-path"),
        "authentication_results": headers.get("authentication-results"),
        "spf":                    headers.get("received-spf"),
        "dkim":                   "present" if headers.get("dkim-signature") else "absent",
        "x_originating_ip":       headers.get("x-originating-ip"),
        "x_mailer":               headers.get("x-mailer"),
        "spam_score":             headers.get("x-spam-score") or headers.get("x-spam-status"),
        "ms_scl":                 headers.get("x-ms-exchange-organization-scl"),
        "forefront_antispam":     headers.get("x-forefront-antispam-report"),
        "received_hops":          [v for k, v in headers.items() if k == "received"][:10],
        "body":                   body[:8000],
    }


def build_prompt(e):
    hops = "\n".join(f"  Hop {i+1}: {h}" for i, h in enumerate(e["received_hops"]))
    return f"""
Subject              : {e['subject']}
From                 : {e['from']}
Reply-To             : {e['reply_to'] or 'not set'}
Return-Path          : {e['return_path'] or 'not set'}
Message-ID           : {e['message_id']}
Authentication-Results: {e['authentication_results'] or 'not present'}
SPF                  : {e['spf'] or 'not present'}
DKIM                 : {e['dkim']}
X-Originating-IP     : {e['x_originating_ip'] or 'not disclosed'}
X-Mailer             : {e['x_mailer'] or 'not disclosed'}
Spam Score           : {e['spam_score'] or 'n/a'}
MS SCL               : {e['ms_scl'] or 'n/a'}
Forefront Antispam   : {e['forefront_antispam'] or 'n/a'}

Received Hops:
{hops or '  none'}

Body:
{e['body'] or '(empty)'}
""".strip()


def analyse_with_ollama(email):
    resp = requests.post(
        f"{OLLAMA_URL}/api/chat",
        json={
            "model": OLLAMA_MODEL,
            "stream": False,
            "options": {"temperature": 0.1},
            "messages": [
                {"role": "system", "content": SYSTEM_PROMPT},
                {"role": "user",   "content": build_prompt(email)},
            ],
        },
        timeout=120,
    )
    resp.raise_for_status()
    raw = resp.json().get("message", {}).get("content", "")
    try:
        return json.loads(raw)
    except json.JSONDecodeError:
        return {"raw_response": raw}


def run(top=5):
    if not all([TENANT_ID, CLIENT_ID, CLIENT_SECRET, USER_EMAIL]):
        raise SystemExit("ERROR: Missing Graph API credentials. Check your .env file.")

    token    = get_token()
    messages = fetch_messages(token, top=top)
    log.info("Fetched %d messages.", len(messages))

    results = []
    for msg in messages:
        subject = msg.get("subject", "(no subject)")
        log.info("Processing: %s", subject)
        try:
            detail   = fetch_message_detail(token, msg["id"])
            email    = extract_email_data(detail)
            analysis = analyse_with_ollama(email)
            log.info("  Verdict: %s (%s%% confidence)",
                     analysis.get("verdict", "?").upper(),
                     analysis.get("confidence", "?"))
            results.append({"subject": subject, "from": email["from"], "analysis": analysis})
        except Exception as e:
            log.error("Failed on '%s': %s", subject, e)
            results.append({"subject": subject, "error": str(e)})

    return results


if __name__ == "__main__":
    import argparse
    parser = argparse.ArgumentParser()
    parser.add_argument("--top",    type=int, default=5,  help="Emails to process")
    parser.add_argument("--output", type=str, default="", help="Save results to JSON file")
    args = parser.parse_args()

    results = run(top=args.top)
    output  = json.dumps(results, indent=2)

    if args.output:
        with open(args.output, "w") as f:
            f.write(output)
        log.info("Results written to %s", args.output)
    else:
        print(output)
